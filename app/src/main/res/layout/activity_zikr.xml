<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="أوقات الصلاة"
        android:textColor="#F4E5B3"
        android:textSize="30sp"
        android:gravity="center"
        android:paddingBottom="18dp" />

    <TextView
        android:id="@+id/prayerFajr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الفجر   05:10"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/prayerSunrise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الشروق   06:38"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/prayerDhuhr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الظهر   12:45"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/prayerAsr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="العصر   16:08"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/prayerMaghrib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="المغرب   18:41"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/prayerIsha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="العشاء   20:05"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:paddingBottom="20dp" />

</LinearLayout>
